17:Ta09,{"@context":"https://schema.org","@type":"Recipe","name":"Pakistani Chapli Kabab","description":"Make crisp-edged, juicy Pakistani chapli kabab with minced beef, fresh herbs and TAVAAZO Chapli Kabab Masala using this straightforward family recipe.","image":["https://trade.mjagrogroup.com/recipes/chapli-kabab.webp"],"author":{"@type":"Organization","name":"TAVAAZO by MJ Agro Group"},"datePublished":"2026-07-23","prepTime":"PT25M","cookTime":"PT20M","totalTime":"PT45M","recipeYield":"5 servings","recipeCategory":"Kabab & BBQ","recipeCuisine":"Pakistani","keywords":"how to make chapli kabab, Pakistani chapli kabab recipe, beef chapli kabab, TAVAAZO Chapli Kabab Masala","recipeIngredient":["750g minced beef with approximately 20% fat","1 packet TAVAAZO Chapli Kabab Masala","1 medium onion, finely chopped and squeezed dry","2 medium tomatoes, deseeded and finely chopped","1 egg","4 tablespoons maize flour or gram flour","2 green chillies, finely chopped","A handful of fresh coriander, chopped","Cooking oil for shallow frying","Lemon wedges and mint chutney to serve"],"recipeInstructions":[{"@type":"HowToStep","position":1,"name":"Step 1","text":"Combine the minced beef, TAVAAZO Chapli Kabab Masala, onion, one chopped tomato, egg, flour, green chillies and coriander.","url":"https://trade.mjagrogroup.com/recipes/chapli-kabab#step-1"},{"@type":"HowToStep","position":2,"name":"Step 2","text":"Mix firmly for 3–4 minutes until the mixture becomes cohesive. Cover and rest in the refrigerator for 20 minutes.","url":"https://trade.mjagrogroup.com/recipes/chapli-kabab#step-2"},{"@type":"HowToStep","position":3,"name":"Step 3","text":"Divide into 10 portions. With damp hands, flatten each portion into a broad, thin patty and press a tomato slice or a little chopped tomato into the top.","url":"https://trade.mjagrogroup.com/recipes/chapli-kabab#step-3"},{"@type":"HowToStep","position":4,"name":"Step 4","text":"Heat a shallow layer of oil in a heavy frying pan over medium heat.","url":"https://trade.mjagrogroup.com/recipes/chapli-kabab#step-4"},{"@type":"HowToStep","position":5,"name":"Step 5","text":"Cook the kababs in batches for 4–5 minutes per side until browned, crisp at the edges and cooked through.","url":"https://trade.mjagrogroup.com/recipes/chapli-kabab#step-5"},{"@type":"HowToStep","position":6,"name":"Step 6","text":"Drain briefly and serve hot with naan, onion, lemon and mint chutney.","url":"https://trade.mjagrogroup.com/recipes/chapli-kabab#step-6"}],"mainEntityOfPage":"https://trade.mjagrogroup.com/recipes/chapli-kabab"}e:["$","main",null,{"className":"recipe-detail-page","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$17"}}],["$","header",null,{"className":"product-detail-nav","children":[["$","$L18",null,{"className":"brand","href":"/","aria-label":"TAVAAZO home","children":["$","img",null,{"src":"/tavaazo-logo.svg","alt":"TAVAAZO - established 2024"}]}],["$","nav",null,{"aria-label":"Recipe navigation","children":[["$","$L18",null,{"href":"/recipes","children":"All recipes"}],["$","$L18",null,{"href":"/#products","children":"Products"}],["$","$L18",null,{"href":"/#partner","children":"Partner with us"}]]}],["$","$L18",null,{"className":"range-button","href":"/recipes","children":"Recipes"}]]}],["$","section",null,{"className":"recipe-hero","children":[["$","div",null,{"className":"recipe-hero-copy","children":[["$","p",null,{"className":"eyebrow green","children":"Kabab & BBQ"}],["$","h1",null,{"children":"Pakistani Chapli Kabab"}],"$L19","$L1a"]}],"$L1b"]}],"$L1c","$L1d"]}]
