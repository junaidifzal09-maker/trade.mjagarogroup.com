17:Tb46,{"@context":"https://schema.org","@type":"Recipe","name":"Pakistani Chicken Biryani","description":"Learn how to make aromatic Pakistani chicken biryani with layered basmati rice, tender chicken and TAVAAZO Biryani Masala for consistent family-style flavour.","image":["https://trade.mjagrogroup.com/recipes/chicken-biryani.webp"],"author":{"@type":"Organization","name":"TAVAAZO by MJ Agro Group"},"datePublished":"2026-07-23","prepTime":"PT25M","cookTime":"PT55M","totalTime":"PT80M","recipeYield":"6 servings","recipeCategory":"Rice & Biryani","recipeCuisine":"Pakistani","keywords":"Pakistani chicken biryani recipe, how to make chicken biryani, easy biryani recipe, TAVAAZO Biryani Masala","recipeIngredient":["750g bone-in chicken pieces","500g basmati rice, rinsed and soaked for 30 minutes","1 packet TAVAAZO Biryani Masala","250g plain yoghurt","3 medium onions, thinly sliced","3 medium tomatoes, chopped","2 tablespoons TAVAAZO Ginger Garlic Paste","120ml cooking oil","1 lemon, sliced","A handful each of fresh mint and coriander","Optional: saffron or yellow food colour mixed with 3 tablespoons warm milk"],"recipeInstructions":[{"@type":"HowToStep","position":1,"name":"Step 1","text":"Heat the oil in a heavy pot and fry the sliced onions until deep golden. Reserve one-third for layering.","url":"https://trade.mjagrogroup.com/recipes/chicken-biryani#step-1"},{"@type":"HowToStep","position":2,"name":"Step 2","text":"Add the chicken and cook for 5 minutes. Stir in the ginger garlic paste, tomatoes, yoghurt and TAVAAZO Biryani Masala.","url":"https://trade.mjagrogroup.com/recipes/chicken-biryani#step-2"},{"@type":"HowToStep","position":3,"name":"Step 3","text":"Cover and cook over medium heat for 20–25 minutes, stirring occasionally, until the chicken is tender and the masala is thick.","url":"https://trade.mjagrogroup.com/recipes/chicken-biryani#step-3"},{"@type":"HowToStep","position":4,"name":"Step 4","text":"Meanwhile, boil the soaked rice in salted water until about 70% cooked. Drain thoroughly.","url":"https://trade.mjagrogroup.com/recipes/chicken-biryani#step-4"},{"@type":"HowToStep","position":5,"name":"Step 5","text":"Spread half the rice over the chicken. Add mint, coriander, lemon and some reserved fried onion, then cover with the remaining rice.","url":"https://trade.mjagrogroup.com/recipes/chicken-biryani#step-5"},{"@type":"HowToStep","position":6,"name":"Step 6","text":"Drizzle over the saffron milk, top with the remaining fried onion and cover tightly.","url":"https://trade.mjagrogroup.com/recipes/chicken-biryani#step-6"},{"@type":"HowToStep","position":7,"name":"Step 7","text":"Steam on very low heat for 15–20 minutes. Rest for 5 minutes, then gently fold the layers and serve.","url":"https://trade.mjagrogroup.com/recipes/chicken-biryani#step-7"}],"mainEntityOfPage":"https://trade.mjagrogroup.com/recipes/chicken-biryani"}e:["$","main",null,{"className":"recipe-detail-page","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$17"}}],["$","header",null,{"className":"product-detail-nav","children":[["$","$L18",null,{"className":"brand","href":"/","aria-label":"TAVAAZO home","children":["$","img",null,{"src":"/tavaazo-logo.svg","alt":"TAVAAZO - established 2024"}]}],["$","nav",null,{"aria-label":"Recipe navigation","children":[["$","$L18",null,{"href":"/recipes","children":"All recipes"}],"$L19","$L1a"]}],"$L1b"]}],"$L1c","$L1d","$L1e"]}]
