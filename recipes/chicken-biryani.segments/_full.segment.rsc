2:Tb88,{"@context":"https://schema.org","@graph":[{"@type":"Organization","@id":"https://trade.mjagrogroup.com/#organization","name":"MJ Agro Group","url":"https://mjagrogroup.com/","email":"info@mjagrogroup.com","telephone":"+923350343465","contactPoint":[{"@type":"ContactPoint","contactType":"EU and UK sales enquiries","telephone":"+33758496334","areaServed":["EU","GB","NO","IS","LI","CH"],"availableLanguage":["English","French"]},{"@type":"ContactPoint","contactType":"Global sales enquiries","telephone":"+923350343465","areaServed":"Worldwide","availableLanguage":"English"}],"logo":"https://trade.mjagrogroup.com/tavaazo-logo.svg","image":"https://trade.mjagrogroup.com/og-share-image.jpg","brand":{"@type":"Brand","name":"TAVAAZO"},"sameAs":["https://www.instagram.com/tavaazo_/","https://www.tiktok.com/@tavaazo_","https://www.facebook.com/profile.php?id=61586582204122","https://www.youtube.com/@mjagrogroup"]},{"@type":"WebSite","@id":"https://trade.mjagrogroup.com/#website","url":"https://trade.mjagrogroup.com/","name":"TAVAAZO","publisher":{"@id":"https://trade.mjagrogroup.com/#organization"},"inLanguage":["en-GB","fr-FR"]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What is TAVAAZO?","acceptedAnswer":{"@type":"Answer","text":"TAVAAZO is the flagship consumer food brand of MJ Agro Group, offering authentic Pakistani and South Asian recipe mixes, spices, culinary pastes and cooking essentials for modern kitchens."}},{"@type":"Question","name":"Which TAVAAZO products are available?","acceptedAnswer":{"@type":"Answer","text":"The current range includes 31 products across biryani and pulao blends, BBQ and tandoori masalas, heritage slow-cook recipes, kabab and seafood mixes, vegetarian and chaat seasonings, basic spices, fried onion and culinary pastes."}},{"@type":"Question","name":"Where can I find TAVAAZO products in Europe?","acceptedAnswer":{"@type":"Answer","text":"TAVAAZO is developing retail and distribution availability across France, Germany, the United Kingdom and other European markets. Contact the team for current availability in your country."}},{"@type":"Question","name":"Can European retailers and distributors partner with TAVAAZO?","acceptedAnswer":{"@type":"Answer","text":"Yes. Retailers, wholesalers, distributors and HORECA suppliers can use the Partner with us form to request product information, documents and a market-specific B2B quotation."}},{"@type":"Question","name":"Does TAVAAZO offer Pakistani biryani and curry spice mixes?","acceptedAnswer":{"@type":"Answer","text":"Yes. The range includes Biryani Masala, Bombay Biryani, Sindhi Biryani, Mutton Biryani, Yakhni Pulao, Qorma, Nihari, Paya, Haleem and other Pakistani cooking blends."}},{"@type":"Question","name":"Where can I download the TAVAAZO catalogue?","acceptedAnswer":{"@type":"Answer","text":"The complete 2026 TAVAAZO product catalogue can be opened or downloaded from the Catalogue links on the website."}}]}]}0:{"P":null,"c":["","recipes","chicken-biryani"],"q":"","i":false,"f":[[["",{"children":["recipes",{"children":[["slug","chicken-biryani","d",null],{"children":["__PAGE__",{}]}]}]},"$undefined","$undefined",16],[["$","$1","c",{"children":[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/1d8ed50033788748.css","precedence":"next","crossOrigin":"$undefined","nonce":"$undefined"}]],["$","html",null,{"lang":"en-GB","children":["$","body",null,{"className":"antialiased","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$2"}}],"$L3","$L4"]}]}]]}],{"children":["$L5",{"children":["$L6",{"children":["$L7",{},null,false,null]},null,false,"$@8"]},null,false,"$@8"]},null,false,null],"$L9",false]],"m":"$undefined","G":["$a",[]],"S":true,"h":null,"s":"$undefined","l":"$undefined","p":"$undefined","d":"$undefined","b":"ahWAvfhQ6qI7dE9k4Fg4M"}
