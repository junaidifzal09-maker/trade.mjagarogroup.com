{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/recipes/layout,_N_T_/recipes/[slug]/layout,_N_T_/recipes/[slug]/page,_N_T_/recipes/chapli-kabab"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/recipes/$d$slug/__PAGE__",
    "/recipes/$d$slug",
    "/recipes",
    "/_index",
    "/_head"
  ]
}